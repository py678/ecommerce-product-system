# Prefer node scripts/setup-compose.ts to generate independent random credentials.
# APP_PASSWORD must be URL-safe (use a 64-character hexadecimal value).
POSTGRES_PASSWORD=
APP_PASSWORD=
JWT_SECRET=
WEB_PORT=8088

# zero: stock = 0; low: 0 < stock < threshold; normal: stock >= threshold.
LOW_STOCK_THRESHOLD=6

# Set privately to the company identifier used for administrator registration. Never commit its actual value.
ADMIN_REGISTRATION_COMPANY_ID=
