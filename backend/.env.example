# Copy to .env and replace the placeholder. Never commit actual passwords.
DATABASE_URL="postgresql://silk_shop_app:CHANGE_ME@localhost:5432/silk_shop?schema=public"
# Separate disposable database for migrate dev; never point this at the main database.
SHADOW_DATABASE_URL="postgresql://silk_shop_app:CHANGE_ME@localhost:5432/silk_shop_shadow?schema=public"
PORT=3000
# Generate a new random secret locally; the app refuses to start with an empty secret.
JWT_SECRET=""
JWT_EXPIRES_IN_SECONDS=3600
FRONTEND_ORIGIN="http://localhost:5173"
