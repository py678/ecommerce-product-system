generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String    @unique @db.VarChar(64)
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  products     Product[]

  @@map("users")
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(120)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar(200)
  description String   @default("") @db.Text
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([categoryId, createdAt])
  @@index([createdAt])
  @@map("products")
}

// Durable change journal and tombstones for the optional two-database bridge.
model SyncIdentity {
  id     Int    @id @default(1)
  nodeId String @unique @default(dbgenerated("gen_random_uuid()")) @map("node_id") @db.Uuid

  @@map("_sync_identity")
}

model SyncVersion {
  tableName String   @map("table_name") @db.VarChar(16)
  recordId  String   @map("record_id") @db.Uuid
  changedAt DateTime @map("changed_at") @db.Timestamptz(6)
  originId  String   @map("origin_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid

  @@id([tableName, recordId])
  @@map("_sync_versions")
}

model SyncEvent {
  sequence    BigInt    @id @default(dbgenerated("nextval('_sync_events_sequence_seq'::regclass)"))
  eventId     String    @unique @map("event_id") @db.Uuid
  tableName   String    @map("table_name") @db.VarChar(16)
  recordId    String    @map("record_id") @db.Uuid
  operation   String    @db.VarChar(6)
  rowData     Json?     @map("row_data")
  changedAt   DateTime  @map("changed_at") @db.Timestamptz(6)
  originId    String    @map("origin_id") @db.Uuid
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  attemptedAt DateTime? @map("attempted_at") @db.Timestamptz(6)
  lastError   String?   @map("last_error") @db.VarChar(32)

  @@index([deliveredAt, attemptedAt, sequence])
  @@map("_sync_events")
}
