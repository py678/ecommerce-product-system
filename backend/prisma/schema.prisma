generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OPERATOR
  ADMIN
}

// Immutable identifiers intentionally do not cascade when an account is removed.
model RoleAudit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  fromRole  String   @map("from_role") @db.VarChar(32)
  toRole    String   @map("to_role") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetId, createdAt])
  @@map("role_audits")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String    @unique @db.VarChar(64)
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(OPERATOR)
  roleId       String    @default(dbgenerated("'00000000-0000-4000-8000-000000000011'::uuid")) @map("role_id") @db.Uuid
  roleDefinition Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tokenVersion Int       @default(0) @map("token_version")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy String? @map("deleted_by") @db.Uuid
  deleteReason String? @map("delete_reason") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  products     Product[]
  orders       Order[]

  @@map("users")
  @@index([roleId])
  @@index([deletedAt, createdAt])
}

// No user FK: deletion history and permanent UUID tombstones survive a purge.
model AccountAudit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  targetId String @map("target_id") @db.Uuid
  username String @db.VarChar(64)
  action String @db.VarChar(24)
  reason String @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([targetId, createdAt])
  @@map("account_audits")
}

model UserTombstone {
  id String @id @db.Uuid
  purgedAt DateTime @default(now()) @map("purged_at") @db.Timestamptz(3)
  @@map("user_tombstones")
}

enum DataScope {
  OWN
  ALL
}

model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique @db.VarChar(32)
  name String @db.VarChar(80)
  description String @default("") @db.VarChar(500)
  enabled Boolean @default(true)
  system Boolean @default(false)
  version Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  grants RolePermission[]
  users User[]
  @@map("roles")
}

model PermissionDefinition {
  code String @id @db.VarChar(40)
  name String @db.VarChar(80)
  module String @db.VarChar(20)
  scoped Boolean @default(false)
  grants RolePermission[]
  @@map("permissions")
}

model RolePermission {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code") @db.VarChar(40)
  scope DataScope @default(OWN)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PermissionDefinition @relation(fields: [permissionCode], references: [code], onDelete: Restrict)
  @@unique([roleId, permissionCode])
  @@map("role_permissions")
}

model PermissionAudit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  action String @db.VarChar(24)
  before Json?
  after Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([roleId, createdAt])
  @@map("permission_audits")
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(120)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  Product[]

  @@map("categories")
}

enum ProductStatus {
  PUBLISHED
  OFFLINE
}

model Product {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  categoryId   String      @map("category_id") @db.Uuid
  name         String      @db.VarChar(200)
  description  String      @default("") @db.Text
  coverImage   String?     @map("cover_image") @db.VarChar(2048)
  price        Decimal     @db.Decimal(12, 2)
  stockVersion Int         @default(0) @map("stock_version")
  stock        Int         @default(0)
  status       ProductStatus @default(PUBLISHED)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([categoryId, createdAt])
  @@index([createdAt])
  @@index([stock, createdAt])
  @@index([price, createdAt])
  @@index([updatedAt])
  @@index([status, createdAt])
  @@map("products")
}

// Durable change journal and tombstones for the optional two-database bridge.
model SyncIdentity {
  id     Int    @id @default(1)
  nodeId String @unique @default(dbgenerated("gen_random_uuid()")) @map("node_id") @db.Uuid

  @@map("_sync_identity")
}

model SyncVersion {
  tableName String   @map("table_name") @db.VarChar(16)
  recordId  String   @map("record_id") @db.Uuid
  changedAt DateTime @map("changed_at") @db.Timestamptz(6)
  originId  String   @map("origin_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid

  @@id([tableName, recordId])
  @@map("_sync_versions")
}

model SyncEvent {
  transactionId String    @default(dbgenerated("(pg_current_xact_id())::text")) @map("transaction_id") @db.VarChar(32)
  sequence      BigInt    @id @default(dbgenerated("nextval('_sync_events_sequence_seq'::regclass)"))
  eventId       String    @unique @map("event_id") @db.Uuid
  tableName     String    @map("table_name") @db.VarChar(16)
  recordId      String    @map("record_id") @db.Uuid
  operation     String    @db.VarChar(6)
  rowData       Json?     @map("row_data")
  changedAt     DateTime  @map("changed_at") @db.Timestamptz(6)
  originId      String    @map("origin_id") @db.Uuid
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  attemptedAt   DateTime? @map("attempted_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error") @db.VarChar(32)

  @@index([deliveredAt, attemptedAt, sequence])
  @@index([transactionId, sequence], map: "_sync_events_transaction_id_idx")
  @@map("_sync_events")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

model CommerceConfig {
  id        Int    @id @default(1)
  writeRole String @default("STANDALONE") @map("write_role") @db.VarChar(16)

  @@map("_commerce_config")
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNo        String      @unique @map("order_no") @db.VarChar(40)
  creatorId      String      @map("creator_id") @db.Uuid
  idempotencyKey String      @map("idempotency_key") @db.Uuid
  requestHash    String      @map("request_hash") @db.VarChar(64)
  customerName   String      @map("customer_name") @db.VarChar(80)
  phone          String      @db.VarChar(32)
  address        String      @db.VarChar(500)
  remark         String      @default("") @db.VarChar(1000)
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(18, 2)
  carrier        String?     @db.VarChar(80)
  trackingNo     String?     @map("tracking_no") @db.VarChar(80)
  confirmedAt    DateTime?   @map("confirmed_at") @db.Timestamptz(3)
  shippedAt      DateTime?   @map("shipped_at") @db.Timestamptz(3)
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(3)
  cancelledAt    DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  creator        User        @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  logs           OrderLog[]

  @@unique([creatorId, idempotencyKey])
  @@index([creatorId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  productName String  @map("product_name") @db.VarChar(200)
  coverImage  String? @map("cover_image") @db.VarChar(2048)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(18, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model OrderLog {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  actorId    String       @map("actor_id") @db.Uuid
  actorName  String       @map("actor_name") @db.VarChar(64)
  action     String       @db.VarChar(16)
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  reason     String       @default("") @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_logs")
}

enum StockMovementType {
  BASELINE
  INITIAL
  ADJUSTMENT
  ORDER_DEDUCT
  ORDER_CANCEL
}

// Immutable snapshots intentionally survive product/account deletion.
model StockMovement {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String @map("product_id") @db.Uuid
  productName    String @map("product_name") @db.VarChar(200)
  ownerId        String @map("owner_id") @db.Uuid
  type           StockMovementType
  beforeStock    Int @map("before_stock")
  quantityChange Int @map("quantity_change")
  afterStock     Int @map("after_stock")
  stockVersion   Int @map("stock_version")
  actorId        String? @map("actor_id") @db.Uuid
  actorName      String? @map("actor_name") @db.VarChar(64)
  orderId        String? @map("order_id") @db.Uuid
  orderNo        String? @map("order_no") @db.VarChar(40)
  reason         String @db.VarChar(500)
  operationKey   String @unique @map("operation_key") @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([productId, stockVersion])
  @@index([productId, createdAt])
  @@index([ownerId, createdAt])
  @@index([orderId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt, id])
  @@map("stock_movements")
}
