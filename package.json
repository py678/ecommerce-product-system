{
  "name": "ecommerce-product-system",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=ecommerce-product-system-backend",
    "build:frontend": "turbo run build --filter=ecommerce-product-system-frontend",
    "lint": "turbo run lint",
    "format": "turbo run format && npm exec --workspace frontend -- prettier --write ../package.json ../turbo.json",
    "format:check": "turbo run format:check && npm exec --workspace frontend -- prettier --check ../package.json ../turbo.json",
    "test": "turbo run test --filter=ecommerce-product-system-backend",
    "test:orders": "turbo run test:orders --filter=ecommerce-product-system-backend",
    "test:realtime": "turbo run test:realtime --filter=ecommerce-product-system-backend",
    "db:verify": "turbo run db:verify --filter=ecommerce-product-system-backend"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
